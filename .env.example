# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# AI providers
OPENAI_API_KEY=your_openai_key
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
NEURALDEEP_API_KEY=your_neuraldeep_key
NEURALDEEP_BASE_URL=https://api.neuraldeep.ru/v1
NEURALDEEP_MODEL=gemma-4-31b
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# Media / image generation
FAL_KEY=your_fal_key

# Bot admin Telegram numeric ID
ADMIN_ID=123456789

# Storage
DATA_DIR=data
EXPORTS_DIR=data/exports
EXPORT_PUBLIC_BASE_URL=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_BASE=https://graph.instagram.com/v22.0
INSTAGRAM_MEDIA_PROXY_BASE_URL=
INSTAGRAM_MEDIA_PROXY_SECRET=
INSTAGRAM_MEDIA_PROXY_TTL_SECONDS=300
INSTAGRAM_MEDIA_PROXY_BOT_ALIAS=karusel

# Threads Graph API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
THREADS_API_BASE=https://graph.threads.net/v1.0
THREADS_MEDIA_PROXY_BOT_ALIAS=karusel

# Meta app settings (for OAuth / webhooks scaffolding)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_HOST=graph.instagram.com
META_GRAPH_API_VERSION=v24.0
META_WEBHOOK_CALLBACK_URL=
